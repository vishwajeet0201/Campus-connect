# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

map-source/**/*.png
map-source/**/*.jpg
map-source/**/*.jpeg
map-source/**/*.webp
map-source/**/debug.png
map-source/**/crop-detection.png
map-source/**/layout.json
map-source/**/crop.json.suggested
map-source/stitch-summary.json
!map-source/**/stitched.png
!map-source/**/labels.json

# python
__pycache__/
